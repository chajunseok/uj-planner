         Compose 가 그려지기 전 창 배경이 시스템 다크 모드를 따르게 하는 것이 목적이다. -->
    <style name="Theme.UjPlanner" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
